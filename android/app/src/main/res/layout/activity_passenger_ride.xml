<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <include layout="@layout/include_offline_banner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/close"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/action_close"
                app:icon="@drawable/ic_arrow_back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emergency"
                style="@style/Widget.GrabCycle.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/ride_emergency"
                android:visibility="gone"
                app:icon="@drawable/ic_warning" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="280dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_lg">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="@dimen/space_sm"
                android:background="@drawable/bg_sheet_handle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/status_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.GrabCycle.Chip"
                tools:text="Driver on the way" />

            <TextView
                android:id="@+id/status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.GrabCycle.Headline"
                tools:text="Pedro is on the way" />

            <TextView
                android:id="@+id/status_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.GrabCycle.Body" />

            <TextView
                android:id="@+id/cached_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/cached_data_notice"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/gc_status_warning"
                android:visibility="gone" />

            <!-- Searching -->
            <LinearLayout
                android:id="@+id/stage_searching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/offer_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />
            </LinearLayout>

            <!-- Driver assigned -->
            <LinearLayout
                android:id="@+id/stage_driver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/driver_card"
                    layout="@layout/include_driver_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md" />

                <TextView
                    android:id="@+id/location_freshness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

                <LinearLayout
                    android:id="@+id/contact_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/call_driver"
                        style="@style/Widget.GrabCycle.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_call"
                        app:icon="@drawable/ic_phone" />

                    <Space
                        android:layout_width="@dimen/space_sm"
                        android:layout_height="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/message_driver"
                        style="@style/Widget.GrabCycle.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_message" />
                </LinearLayout>
            </LinearLayout>

            <!-- Completed -->
            <LinearLayout
                android:id="@+id/stage_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/final_fare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Amount"
                        tools:text="₱45.00" />

                    <TextView
                        android:id="@+id/payment_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:paddingHorizontal="@dimen/space_md"
                        android:paddingVertical="@dimen/space_xxs"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Chip" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rating_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/ride_rate_driver"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Title" />

                    <RatingBar
                        android:id="@+id/rating_bar"
                        style="?android:attr/ratingBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:numStars="5"
                        android:stepSize="1" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:hint="@string/ride_rating_comment"
                        app:counterEnabled="true"
                        app:counterMaxLength="500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/rating_comment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="500" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit_rating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/ride_submit_rating" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/view_receipt"
                    style="@style/Widget.GrabCycle.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/ride_view_receipt"
                    app:icon="@drawable/ic_receipt" />
            </LinearLayout>

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel"
                style="@style/Widget.GrabCycle.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ride_cancel"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/report"
                style="@style/Widget.GrabCycle.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ride_report_issue"
                android:visibility="gone" />

            <!-- Trip summary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/ride_trip"
                android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

            <TextView
                android:id="@+id/trip_pickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.GrabCycle.Body"
                app:drawableStartCompat="@drawable/ic_my_location"
                app:drawableTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/trip_destination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.GrabCycle.Body"
                app:drawableStartCompat="@drawable/ic_place"
                app:drawableTint="?attr/colorTertiary" />

            <TextView
                android:id="@+id/trip_fare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/ride_timeline"
                android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

            <LinearLayout
                android:id="@+id/timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
