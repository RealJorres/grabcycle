<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fixed centre pin used while the passenger drags the map to place a point. -->
    <ImageView
        android:id="@+id/center_pin"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginBottom="48dp"
        android:contentDescription="@string/ph_pin_desc"
        android:src="@drawable/ic_pin_pickup"
        android:visibility="gone" />

    <TextView
        android:id="@+id/map_unavailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:text="@string/maps_key_missing"
        android:textAppearance="@style/TextAppearance.GrabCycle.Body"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <include layout="@layout/include_offline_banner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/ph_menu"
                app:icon="@drawable/ic_menu" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/my_location"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/ph_my_location"
                app:icon="@drawable/ic_my_location" />
        </LinearLayout>

        <!-- Verification gate: shown until the passenger's ID is approved. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/verify_banner"
            style="@style/Widget.GrabCycle.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSecondaryContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/verify_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        tools:text="Verify your ID to start booking" />

                    <TextView
                        android:id="@+id/verify_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSecondaryContainer" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSecondaryContainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Booking sheet -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_lg"
        app:behavior_hideable="false"
        app:behavior_peekHeight="220dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="@dimen/space_sm"
            android:background="@drawable/bg_sheet_handle"
            android:importantForAccessibility="no" />

        <!-- Stage: location permission needed -->
        <LinearLayout
            android:id="@+id/stage_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/permission_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ph_location_title"
                android:textAppearance="@style/TextAppearance.GrabCycle.Title" />

            <TextView
                android:id="@+id/permission_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/ph_location_rationale"
                android:textAppearance="@style/TextAppearance.GrabCycle.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permission_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/ph_location_allow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permission_skip"
                style="@style/Widget.GrabCycle.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ph_location_skip" />
        </LinearLayout>

        <!-- Stage: where to -->
        <LinearLayout
            android:id="@+id/stage_where"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GrabCycle.Headline"
                tools:text="Magandang araw, Juan!" />

            <LinearLayout
                android:id="@+id/pickup_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_my_location"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ph_pickup"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

                    <TextView
                        android:id="@+id/pickup_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Body"
                        tools:text="Near Boac Cathedral, Boac" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/where_to"
                style="@style/Widget.GrabCycle.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_lg">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:text="@string/ph_where_to"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Stage: place a pin on the map -->
        <LinearLayout
            android:id="@+id/stage_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/pin_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GrabCycle.Title"
                tools:text="Confirm your pickup point" />

            <TextView
                android:id="@+id/pin_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.GrabCycle.Body" />

            <TextView
                android:id="@+id/pin_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/ph_pin_hint"
                android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

            <TextView
                android:id="@+id/pin_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pin_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pin_cancel"
                style="@style/Widget.GrabCycle.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel" />
        </LinearLayout>

        <!-- Stage: fare quote -->
        <LinearLayout
            android:id="@+id/stage_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/route_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GrabCycle.Caption"
                tools:text="Boac → Mogpog" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ph_estimated_fare"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

                    <TextView
                        android:id="@+id/fare_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Amount"
                        tools:text="₱45.00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/passengers_minus"
                        style="@style/Widget.Material3.Button.IconButton.Outlined"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:contentDescription="@string/ph_passengers_minus"
                        android:text="−" />

                    <TextView
                        android:id="@+id/passengers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="64dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.GrabCycle.Body"
                        tools:text="1 passenger" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/passengers_plus"
                        style="@style/Widget.Material3.Button.IconButton.Outlined"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:contentDescription="@string/ph_passengers_plus"
                        android:text="+" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/distance_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

            <TextView
                android:id="@+id/quote_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_banner"
                android:padding="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_breakdown"
                style="@style/Widget.GrabCycle.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ph_show_breakdown" />

            <LinearLayout
                android:id="@+id/breakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/find_driver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/ph_choose_driver" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_back"
                style="@style/Widget.GrabCycle.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ph_change_trip" />
        </LinearLayout>

        <!-- Stage: choose a driver -->
        <LinearLayout
            android:id="@+id/stage_drivers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/drivers_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ph_nearby_drivers"
                    android:textAppearance="@style/TextAppearance.GrabCycle.Title" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/drivers_refreshing"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="20dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/drivers_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GrabCycle.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/book_nearest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/ph_book_nearest" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drivers_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:nestedScrollingEnabled="false" />

            <ph.grabcycle.app.ui.common.StateView
                android:id="@+id/drivers_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/drivers_back"
                style="@style/Widget.GrabCycle.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_back" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheet_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/sheet_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
