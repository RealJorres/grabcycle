<?xml version="1.0" encoding="utf-8"?>
<!-- Release configuration: HTTPS only, system trust anchors. The debug source
     set overrides this file to allow the local Firebase Emulator Suite. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
