# Copy to .env.local (never commit real values). These are PUBLIC web-app
# identifiers from the Firebase console (Project settings > Your apps > Web);
# they are not secrets, but keep them per environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_DATABASE_URL=
VITE_FUNCTIONS_REGION=asia-southeast1

# App Check (reCAPTCHA Enterprise site key). Required when the backend runs
# with ENFORCE_APP_CHECK=true.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development against the Emulator Suite (firebase emulators:start).
VITE_USE_EMULATORS=false
