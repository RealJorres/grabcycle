rules_version = '2';

// GrabCycle Cloud Storage security rules.
//
//   uploads/{uid}/{uploadId}          Staging area. The owner may CREATE a single
//                                     JPEG (re-encoded on device, EXIF stripped).
//                                     No reads, no overwrites. A Cloud Function
//                                     validates the bytes and moves the object to
//                                     private/ when a submission is made.
//   private/**                        Identity & accreditation documents. No
//                                     client access at all; reviewers view them
//                                     through an audited Cloud Function.
//   public/driverPhotos/{uid}/{file}  Approved driver profile photos, copied by
//                                     the server after approval. Readable by
//                                     signed-in users for passenger safety.
service firebase.storage {
  match /b/{bucket}/o {

    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isActiveAccount(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId))
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.status == 'ACTIVE';
    }

    match /uploads/{userId}/{uploadId} {
      // `resource == null`: uploading over an existing object is evaluated as a
      // create in Cloud Storage, so overwrites must be rejected explicitly.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && resource == null
        && uploadId.matches('^[A-Za-z0-9_-]{20,64}$')
        && request.resource.size > 1024
        && request.resource.size <= 6 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && isActiveAccount(userId);

      // Owner may discard an upload before submitting it.
      allow delete: if request.auth != null && request.auth.uid == userId;

      allow get, list, update: if false;
    }

    match /public/driverPhotos/{driverId}/{fileName} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
  }
}
