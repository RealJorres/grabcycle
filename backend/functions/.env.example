# Copy to `.env.<firebase-project-id>` (e.g. .env.grabcycle-prod) and adjust.
# Non-secret deployment parameters only. Secrets live in Secret Manager:
#   firebase functions:secrets:set MAPS_SERVER_KEY
FUNCTIONS_REGION=asia-southeast1
ENFORCE_APP_CHECK=true
DEPLOY_ENV=production
# Comma-separated admin dashboard origins (Firebase Hosting domains).
ADMIN_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com
